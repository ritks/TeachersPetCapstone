# Backend API base URL. Local dev: http://localhost:8000
# In Vercel (production), set to your Railway backend URL, e.g. https://teachers-pet-api.up.railway.app
VITE_API_BASE_URL=http://localhost:8000

# Firebase web app config (safe to expose — these are client-side keys, gated by Firebase security rules)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Credentials for the live dashboard E2E tests (student-dashboard.spec.ts,
# teacher-dashboard.spec.ts). Put REAL values in .env.local (gitignored), NOT here.
# Use dedicated, disposable test accounts. No VITE_ prefix, so these stay in the
# Node test process and are never bundled into the browser. In CI these come from
# GitHub Actions secrets instead. The specs self-skip if they are absent.
# E2E_STUDENT_EMAIL=
# E2E_STUDENT_PASSWORD=
# E2E_TEACHER_EMAIL=
# E2E_TEACHER_PASSWORD=
